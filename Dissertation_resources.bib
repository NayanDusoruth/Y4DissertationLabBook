@article{DavidMpemba2026,
	title = {Non-{Markovian} {Quantum} {Mpemba} {Effect}},
	volume = {134},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.134.220403},
	doi = {10.1103/PhysRevLett.134.220403},
	abstract = {Since its rediscovery in the twentieth century, the Mpemba effect, where a far-from-equilibrium state may relax faster than a state closer to equilibrium, has been extensively studied in classical systems and has recently received attention in quantum systems. Many theories explaining this counter-intuitive behavior in classical systems rely on memory effects. However, in quantum systems, the relation between the Mpemba effect and memory has remained unexplored. In this Letter, we consider general non-Markovian open quantum systems and reveal new classes of quantum Mpemba effects, with no analog in Markovian quantum dynamics. Generically, open quantum dynamics possess a finite memory time and a unique steady state. Because of non-Markovian dynamics, even if the system is initialized in the steady state it can take a long time to relax back. We find other initial states that reach the steady state much faster. Most notably, we demonstrate that there can be an initial state in which the system reaches the steady state within the finite memory time itself, giving the fastest possible relaxation to stationarity. We verify the effect for quantum dot systems coupled to electronic reservoirs in equilibrium and nonequilibrium setups at weak, intermediate and strong coupling. Our Letter provides new insights into the rich physics underlying accelerated relaxation in quantum systems.},
	number = {22},
	urldate = {2026-09-09},
	journal = {Physical Review Letters},
	publisher = {American Physical Society},
	author = {Strachan, David J. and Purkayastha, Archak and Clark, Stephen R.},
	month = jun,
	year = {2025},
	keywords = {open quantum systems},
	pages = {220403},
	file = {APS Snapshot:/Users/nayandusoruth/Zotero/storage/DMTFMM9Y/PhysRevLett.134.html:text/html;Full Text PDF:/Users/nayandusoruth/Zotero/storage/PYEIF9NB/Strachan et al. - 2025 - Non-Markovian Quantum Mpemba Effect.pdf:application/pdf},
}

