}

@article{scaryPaper2019,
	title = {Five approaches to exact open-system dynamics: {Complete} positivity, divisibility and time-dependent observables},
	volume = {151},
	issn = {0021-9606, 1089-7690},
	shorttitle = {Five approaches to exact open-system dynamics},
	url = {http://arxiv.org/abs/1903.04195},
	doi = {10.1063/1.5094412},
	abstract = {To extend the classical concept of Markovianity to an open quantum system, different notions of the divisibility of its dynamics have been introduced. Here we analyze this issue by five complementary approaches: equations of motion, real-time diagrammatics, Kraus-operator sums, as well as time-local (TCL) and nonlocal (Nakajima-Zwanzig) quantum master equations. As a case study featuring several types of divisible dynamics, we examine in detail an exactly solvable noninteracting fermionic resonant level coupled arbitrarily strongly to a fermionic bath at arbitrary temperature in the wideband limit. In particular, the impact of divisibility on the time-dependence of the observable level occupation is investigated and compared with typical Markovian approximations. We find that the loss of semigroup-divisibility is accompanied by a prominent reentrant behavior: Counter to intuition, the level occupation may temporarily {\textbackslash}emph\{increase\} significantly in order to reach a stationary state with {\textbackslash}emph\{smaller\} occupation, implying a reversal of the measurable transport current. In contrast, the loss of the so-called completely-positive divisibility is more subtly signaled by the {\textbackslash}emph\{prohibition\} of such current reversals in specific time-intervals. Experimentally, it can be detected in the family of transient currents obtained by varying the initial occupation. To quantify the nonzero footprint left by the system in its effective environment, we determine the exact time-dependent state of the latter as well as related information measures such as entropy, exchange entropy and coherent information.},
	number = {4},
	urldate = {2026-09-30},
	journal = {The Journal of Chemical Physics},
	author = {Reimer, Viktor and Wegewijs, Maarten Rolf and Nestmann, Konstantin and Pletyukhov, Mikhail},
	month = jul,
	year = {2019},
	note = {arXiv:1903.04195 [quant-ph]},
	keywords = {Condensed Matter - Statistical Mechanics, Quantum Physics},
	pages = {044101},
	annote = {Comment: Submitted to The Journal of Chemical Physics, 19 pages + 14 pages of appendices with 13 figures. Significantly extended introduction and discussion, no results changed},
	annote = {"scary paper" - seemingly doing something similar to this project - therefore useful for A) comparison, and B) gathering context on this field of research (plus many citations which may be useful for further reading)},
	file = {Preprint PDF:/Users/nayandusoruth/Zotero/storage/XHQFEU65/Reimer et al. - 2019 - Five approaches to exact open-system dynamics Complete positivity, divisibility and time-dependent.pdf:application/pdf;Snapshot:/Users/nayandusoruth/Zotero/storage/Q9BW2F9T/1903.html:text/html},
}

@misc{Abiuso2025,
	title = {An information-theoretic proof of the {Planckian} bound for thermalization},
	url = {http://arxiv.org/abs/2506.19188},
	doi = {10.48550/arXiv.2506.19188},
	abstract = {We demonstrate that quantum mechanics entails a fundamental lower bound on the thermalization time \$τ\$ of any system. At finite temperature, we show that \$τ\$ is bounded by half the Planckian dissipation time, \$τ{\textbackslash}geq τ\_\{{\textbackslash}rm Pl\}/2\$ with \$τ\_\{{\textbackslash}rm Pl\} = {\textbackslash}hbar/(k\_\{{\textbackslash}rm B\} T)\$. In the low-temperature regime, our bound takes the form \$τ{\textbackslash}geq {\textbackslash}hbar / Δ\$ with \$Δ\$ the spectral gap, in close connection with the quantum adiabatic theorem. These bounds, rooted in Hamiltonian estimation, hold for arbitrary quantum processes that output states close to the corresponding thermal ensemble for a nontrivial class of Hamiltonians.},
	urldate = {2026-09-30},
	publisher = {arXiv},
	author = {Abiuso, Paolo and Rolandi, Alberto and Calsamiglia, John and Sekatski, Pavel and Perarnau-Llobet, Martí},
